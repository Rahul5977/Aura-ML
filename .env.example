# Environment variables template
# Copy this file to .env and fill in your values

# Environment
ENV=development

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
API_RELOAD=true

# Model Paths (relative to project root)
ECE_MODEL_PATH=data/models/ece/ece_roberta_model
LLM_MODEL_PATH=data/models/llm/llama3_finetuned_final

# GPU Configuration
USE_GPU=true
MAX_GPU_MEMORY=6GB

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/outputs/aura_ml.log

# Random Seed
RANDOM_SEED=42
